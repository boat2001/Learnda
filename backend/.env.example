NODE_ENV=development
PORT=5000
HOST=0.0.0.0
# Prefer .env.development.example or .env.production.example for new setups.
# This file remains as a legacy generic reference.
# Paystack redirects here after payment. Use the same host:port you open in the browser. sync-ip keeps localhost values and updates stale LAN IPs.
APP_PUBLIC_URL=http://localhost:5175
# Comma-separated browser origins allowed to call this API with credentials. In production, list exact origins only (wildcard * is rejected at startup).
CORS_ORIGIN=http://localhost:5175,http://127.0.0.1:5175,http://192.168.1.10:5175,http://localhost:8081,http://127.0.0.1:8081,http://192.168.1.10:8081
DEFAULT_SEMESTER=1

# Database
DATABASE_URL=
# One-off DB sync target, for scripts such as db:sync-course-catalog.
# Keep production URLs out of git; set this only in your local env or shell.
TARGET_DATABASE_URL=
# Optional. Leave blank for auto-detection; set false when the target is local Postgres without SSL.
TARGET_DATABASE_SSL=
DB_USERNAME=postgres
DB_PASSWORD=your_db_password
DB_DATABASE=sharether
DB_HOST=localhost
DB_PORT=5433
DB_LOGGING=false
DB_SYNC=alter
SEED_DEFAULT_PLANS=

# JWT
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_refresh_secret
JWT_RESET_SECRET=your_reset_secret
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_EXPIRES_IN=1h

# OAuth
# Google Sign-In (OAuth 2.0 Web client). Same Client ID as frontend VITE_GOOGLE_CLIENT_ID.
# The SPA uses redirect mode: Google returns to https://<your-site>/auth/google/callback.
# Add that full URL under "Authorized redirect URIs" in Google Cloud. CORS_ORIGIN must list
# the SPA origin (scheme + host, no path), e.g. https://beta.sharether.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Optional: if the client does not send redirectUri, set the exact callback URL (must match Google Console).
# GOOGLE_REDIRECT_URI=https://localhost:5173/auth/google/callback

# YouTube Data API v3 (optional — only for backend/src/scripts/seed_eduvhibe_second_sem_youtube.js)
YOUTUBE_API_KEY=

# AI import pipeline
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
OCR_LANGUAGE=eng
OCR_DENSITY=200
OCR_MAX_PAGES=

# Payments
PAYSTACK_SECRET_KEY=
PAYSTACK_PLAN_CODE_MAP={}

# Email — Resend (https://resend.com)
# 1. Create a free Resend account and add/verify your domain
# 2. Generate an API key (Resend dashboard → API Keys → Create API Key)
# 3. Set EMAIL_FROM to an address on that verified domain
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Sharether <noreply@sharether.com>
SUPPORT_EMAIL_RECIPIENTS=admin@sharether.com

# SMS — Arkesel (https://arkesel.com)
SMS_PROVIDER=arkesel
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=Sharether

# Cloudflare R2 (S3-compatible)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=sharether-content
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-<HASH>.r2.dev

# Manual content-collection scripts (no background scheduler).
# Public Telegram usernames only.
NOTES_TELEGRAM_CHANNELS=
NOTES_SCRAPER_MAX_PER_COURSE=3
NOTES_SCRAPER_MAX_FILE_MB=30
NOTES_SCRAPER_SEARCH_RESULTS=5
NOTES_SCRAPER_TELEGRAM_RESULTS=5
NOTES_SCRAPER_DDG_RESULTS=10
NOTES_SCRAPER_QUERY_VARIANTS=3
NOTES_SCRAPER_DELAY_MS=900
NOTES_SCRAPER_TIMEOUT_MS=20000
NOTES_SCRAPER_PAGE_TIMEOUT_MS=10000
NOTES_SCRAPER_RETRIES=3
EDUTAINMENT_COLLECT_LIMIT=5000
EDUTAINMENT_COLLECT_BATCH_SIZE=500
EDUTAINMENT_SHARD_SIZE=1000
EDUTAINMENT_COLLECT_DELAY_MS=300
EDUTAINMENT_COLLECT_TIMEOUT_MS=20000
EDUTAINMENT_COLLECT_RETRIES=3
EDUTAINMENT_CONTACT_EMAIL=admin@sharether.com
DISABLE_REGISTRATION_OTP_VERIFICATION=false

# Logging
LOG_LEVEL=info
LOG_FILE=

# Rewards
REWARD_PAYOUT_THRESHOLD=10
REWARD_INVITE_DOWNLOAD_AMOUNT=0.5
REWARD_INVITE_REGISTER_AMOUNT=0.5
REWARD_STREAK_AMOUNT=1
REWARD_CONTRIBUTE_AMOUNT=1

# Feature flags
ENABLE_CONTRIBUTIONS=true
ENABLE_GAMIFICATION=true
ENABLE_ANALYTICS=true
ENABLE_SOCIAL_SUBSCRIPTION_POPUP=true
ENABLE_SPOTLIGHT_POPUP=true
