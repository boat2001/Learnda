# Copy to .env.development.local for local development.
# sync-ip updates local LAN URL entries in that local file.
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
APP_PUBLIC_URL=http://localhost:5175
CORS_ORIGIN=http://localhost:5175,http://127.0.0.1:5175,http://192.168.1.10:5175,http://localhost:8081,http://127.0.0.1:8081,http://192.168.1.10:8081
DEFAULT_SEMESTER=1

DATABASE_URL=
TARGET_DATABASE_URL=
TARGET_DATABASE_SSL=
DB_USERNAME=postgres
DB_PASSWORD=your_db_password
DB_DATABASE=learnda
DB_HOST=localhost
DB_PORT=5433
DB_LOGGING=false
DB_SYNC=alter
SEED_DEFAULT_PLANS=

JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_refresh_secret
JWT_RESET_SECRET=your_reset_secret
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_EXPIRES_IN=1h

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=
YOUTUBE_API_KEY=

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=
OCR_LANGUAGE=eng
OCR_DENSITY=200
OCR_MAX_PAGES=

PAYSTACK_SECRET_KEY=
PAYSTACK_PLAN_CODE_MAP={}

RESEND_API_KEY=
EMAIL_FROM=Learnda <noreply@learnda.app>
SUPPORT_EMAIL_RECIPIENTS=admin@learnda.app

SMS_PROVIDER=arkesel
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=Learnda

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=learnda-content
R2_ENDPOINT=
R2_PUBLIC_URL=

DISABLE_REGISTRATION_OTP_VERIFICATION=false

LOG_LEVEL=info
LOG_FILE=

REWARD_PAYOUT_THRESHOLD=10
REWARD_INVITE_DOWNLOAD_AMOUNT=0.5
REWARD_INVITE_REGISTER_AMOUNT=0.5
REWARD_STREAK_AMOUNT=1
REWARD_CONTRIBUTE_AMOUNT=1

ENABLE_CONTRIBUTIONS=true
ENABLE_GAMIFICATION=true
ENABLE_ANALYTICS=true

# Absolute URL to the logo used in transactional emails.
# Falls back to $R2_PUBLIC_URL/brand/learnda-logo.png, then $APP_PUBLIC_URL/learnda-logo.png.
BRAND_LOGO_URL=
