# Use deployment environment variables in production.
# Keep secrets out of git and do not run sync-ip against this file.
NODE_ENV=production
VERCEL=1
PORT=5000
HOST=0.0.0.0
# Canonical SPA URL on Render (see render.yaml). Add extra origins comma-separated (no paths).
APP_PUBLIC_URL=https://beta.sharether.com
CORS_ORIGIN=https://beta.sharether.com,https://sharether-web-r74a.onrender.com,https://sharether.com
DEFAULT_SEMESTER=1

DATABASE_URL=
DATABASE_SSL=true
DB_POOL_MAX=2
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
DB_LOGGING=false
DB_SYNC=none
SEED_DEFAULT_PLANS=false

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_RESET_SECRET=
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_EXPIRES_IN=1h

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Prefer unset; SPA sends redirectUri. If set: https://beta.sharether.com/auth/google/callback
# GOOGLE_REDIRECT_URI=
YOUTUBE_API_KEY=

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
GEMINI_API_KEY=
OCR_LANGUAGE=eng
OCR_DENSITY=200
OCR_MAX_PAGES=

PAYSTACK_SECRET_KEY=
PAYSTACK_PLAN_CODE_MAP={}

RESEND_API_KEY=
EMAIL_FROM=Sharether <noreply@sharether.com>
SUPPORT_EMAIL_RECIPIENTS=

SMS_PROVIDER=arkesel
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=Sharether

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET=sharether-content
R2_ENDPOINT=
R2_PUBLIC_URL=

CRON_SECRET=replace-with-a-random-secret-at-least-16-characters
DISABLE_REGISTRATION_OTP_VERIFICATION=false

LOG_LEVEL=info
LOG_FILE=

REWARD_PAYOUT_THRESHOLD=10
REWARD_INVITE_DOWNLOAD_AMOUNT=0.5
REWARD_INVITE_REGISTER_AMOUNT=0.5
REWARD_STREAK_AMOUNT=1
REWARD_CONTRIBUTE_AMOUNT=1

ENABLE_CONTRIBUTIONS=true
ENABLE_GAMIFICATION=true
ENABLE_ANALYTICS=true
ENABLE_SOCIAL_SUBSCRIPTION_POPUP=false
ENABLE_SPOTLIGHT_POPUP=false
