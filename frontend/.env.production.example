# Public frontend values for a production build.
# VITE_ values are exposed to the browser.
VITE_API_BASE_URL=/api
VITE_SITE_URL=https://beta.learnda.app
# Same Web client ID as backend GOOGLE_CLIENT_ID. See docs/deploy/GOOGLE_OAUTH_RENDER.md for Google Console URIs.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_ANDROID_APP_URL=
VITE_IOS_APP_URL=
VITE_PLACEHOLDER_MODE=

# Google Analytics measurement ID (e.g. G-XXXXXXXXXX). Leave blank to disable analytics.
VITE_GA_MEASUREMENT_ID=
