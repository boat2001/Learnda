{
  "id": "/",
  "name": "Learnda",
  "short_name": "Learnda",
  "description": "Ghana's K-12 learning platform. Lessons, practice and revision scoped to your class, from KG to SHS.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#2b62c4",
  "categories": ["education", "productivity"],
  "icons": [
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    },
    {
