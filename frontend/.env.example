# Prefer .env.development.example or .env.production.example for new setups.
# This file remains as a legacy generic reference.
VITE_API_BASE_URL=http://localhost:5000
VITE_SITE_URL=http://localhost:5173
# Same Web client ID as backend GOOGLE_CLIENT_ID (Google Cloud Console → APIs & Services → Credentials).
# In Google Cloud, add Authorized JavaScript origins (e.g. http://localhost:5173, https://beta.sharether.com)
# and Authorized redirect URIs: same origins plus /auth/google/callback on each, e.g.
# https://beta.sharether.com/auth/google/callback
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_ANDROID_APP_URL=
VITE_IOS_APP_URL=
# Optional: set to "on" to force placeholder content mode in frontend/src/services/placeholderData.js
VITE_PLACEHOLDER_MODE=
