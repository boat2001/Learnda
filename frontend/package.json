{
  "name": "frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync-ip": "node ../sync-ip.cjs",
    "dev": "node ../sync-ip.cjs && vite",
    "dev:fresh": "node --input-type=module -e \"import fs from 'node:fs'; try { fs.rmSync('node_modules/.vite', { recursive: true, force: true }); } catch (_) {}\" && node ../sync-ip.cjs && vite",
    "build": "vite build",
    "preview": "vite preview",
    "compress-images": "node scripts/compress-images.js",
    "build:analyze": "cross-env ANALYZE=true vite build"
  },
  "dependencies": {
    "dompurify": "^3.2.7",
    "katex": "^0.16.21",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet": "^6.1.0",
    "react-icons": "^5.5.0",
    "react-image-crop": "^11.0.10",
    "react-router-dom": "^6.30.3",
    "recharts": "^3.8.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "cross-env": "^10.1.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.34.5",
    "vite": "^5.0.0"
  }
}
